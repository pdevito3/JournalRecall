# Copy to `.env` (gitignored) and adjust for your home lab, then `docker compose up -d --build`.

# Host port to publish the app on. Container always listens on 8080 internally.
JOURNALRECALL_PORT=8080

# Where the SQLite database is stored.
#   - Leave unset/default to use the Docker-managed named volume `journalrecall-data`.
#   - Set to a host path to bind-mount instead (recommended for a NAS/home lab so you control
#     backups). The path must be writable by UID 1654 — run `sudo chown -R 1654:1654 <path>` once,
#     or set JOURNALRECALL_UID/GID below and uncomment `user:` in compose.yaml.
# JOURNALRECALL_DATA=/mnt/tank/journalrecall

# Only needed when bind-mounting to a path you can't chown to 1654 (see compose.yaml `user:`).
# JOURNALRECALL_UID=1000
# JOURNALRECALL_GID=1000

# REQUIRED in production: a >=32-byte secret for signing JWTs. The app refuses to start without one.
# Generate with: openssl rand -base64 48
JWT__SIGNINGKEY=change-me-in-production-please-use-a-32byte+-secret

# Optional — BYO OpenAI-compatible endpoint for AI Cleanup (leave blank to disable).
# CHATMODELS__CLEANUP__ENDPOINT=http://your-ollama-host:11434/v1
# CHATMODELS__CLEANUP__APIKEY=
# CHATMODELS__CLEANUP__MODEL=llama3.1
